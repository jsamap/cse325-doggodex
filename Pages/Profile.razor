@page "/profile"
@using DoggoDex.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>DoggoDex - My Profile</PageTitle>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        @{
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    </NotAuthorized>
    
    <Authorized>
        <div class="container mt-4 animate-fade" style="max-width: 600px;">
            <div class="mb-4 text-center text-sm-start">
                <h1 class="fw-bold mb-1">👤 Account Profile</h1>
                <p class="text-muted mb-0">Manage your profile metadata information and contact details.</p>
            </div>

            @if (!isLoaded)
            {
                <div class="text-center my-5 py-5">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <p class="text-muted small">Loading account metadata...</p>
                </div>
            }
            else
            {
                <div class="card shadow-sm border border-light p-4 bg-white mb-4 rounded-3">
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert @(statusMessage.StartsWith("Error") ? "alert-danger" : "alert-success") py-2 small mb-3 animate-fade">
                            @statusMessage
                        </div>
                    }

                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="text-white d-flex align-items-center justify-content-center rounded-circle fw-bold" style="width: 60px; height: 60px; background: linear-gradient(135deg, #00143a 0%, #002e85 100%);">
                            <span style="font-size: 1.8rem;">👤</span>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0 text-dark">@accountEmail</h4>
                            <span class="badge bg-secondary fw-normal">Role: @(userType == "DogOwner" ? "Dog Owner" : "Business Owner")</span>
                        </div>
                    </div>

                    <!-- PROFILE READ-ONLY VIEW MODE -->
                    @if (!isEditMode)
                    {
                        <div class="d-flex flex-column gap-3 text-start">
                            @if (userType == "DogOwner" && dogOwnerProfile != null)
                            {
                                <div>
                                    <label class="text-muted small fw-bold text-uppercase mb-1 d-block">First Name</label>
                                    <div class="fs-5 fw-bold text-dark p-2 bg-light rounded">@dogOwnerProfile.FirstName</div>
                                </div>
                                <div>
                                    <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Last Name</label>
                                    <div class="fs-5 fw-bold text-dark p-2 bg-light rounded">@dogOwnerProfile.LastName</div>
                                </div>
                            }
                            else if (userType == "BusinessOwner" && businessOwnerProfile != null)
                            {
                                <div>
                                    <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Business Name</label>
                                    <div class="fs-5 fw-bold text-dark p-2 bg-light rounded">@businessOwnerProfile.BusinessName</div>
                                </div>
                                <div>
                                    <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Contact Email</label>
                                    <div class="fs-5 fw-bold text-dark p-2 bg-light rounded">@businessOwnerProfile.ContactEmail</div>
                                </div>
                            }

                            <div class="pt-3 border-top mt-2">
                                <button class="btn btn-primary px-4 fw-bold rounded-pill w-100" @onclick="ToggleEditMode">
                                    ✏ Edit Profile Details
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- PROFILE INTERACTIVE EDITING MODE -->
                        <EditForm Model="@this" OnValidSubmit="HandleProfileUpdateAsync">
                            <div class="d-flex flex-column gap-3 text-start">
                                @if (userType == "DogOwner" && editDogOwner != null)
                                {
                                    <div>
                                        <label class="form-label fw-bold small text-muted">First Name</label>
                                        <InputText @bind-Value="editDogOwner.FirstName" class="form-control form-control-lg" required />
                                    </div>
                                    <div>
                                        <label class="form-label fw-bold small text-muted">Last Name</label>
                                        <InputText @bind-Value="editDogOwner.LastName" class="form-control form-control-lg" required />
                                    </div>
                                }
                                else if (userType == "BusinessOwner" && editBusinessOwner != null)
                                {
                                    <div>
                                        <label class="form-label fw-bold small text-muted">Business Name</label>
                                        <InputText @bind-Value="editBusinessOwner.BusinessName" class="form-control form-control-lg" required />
                                    </div>
                                    <div>
                                        <label class="form-label fw-bold small text-muted">Contact Email</label>
                                        <InputText @bind-Value="editBusinessOwner.ContactEmail" type="email" class="form-control form-control-lg" required />
                                    </div>
                                }

                                <div class="pt-3 border-top d-flex gap-2 justify-content-end mt-2">
                                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" @onclick="ToggleEditMode" disabled="@isSaving">Cancel</button>
                                    <button type="submit" class="btn btn-success px-4 fw-bold rounded-pill d-flex align-items-center gap-2" disabled="@isSaving">
                                        @if (isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                            <span>Saving Changes...</span>
                                        }
                                        else
                                        {
                                            <span>Save Changes</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    }
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>




@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? userId;
    private string? userType;
    private string? accountEmail;
    
    private DogOwner? dogOwnerProfile;
    private BusinessOwner? businessOwnerProfile;

    private DogOwner? editDogOwner;
    private BusinessOwner? editBusinessOwner;

    private bool isLoaded = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask == null) return;
        var authState = await AuthStateTask;
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            userType = user.FindFirst("UserType")?.Value;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            accountEmail = user.Identity.Name;

            await LoadProfileDataAsync();
        }
        else
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        isLoaded = true;
    }

    private async Task LoadProfileDataAsync()
    {
        if (string.IsNullOrEmpty(userId)) return;

        using var scope = ServiceProvider.CreateScope();
        var dbContext = scope.ServiceProvider.GetRequiredService<DoggoDbContext>();

        if (userType == "DogOwner")
        {
            dogOwnerProfile = await dbContext.DogOwners
                .FirstOrDefaultAsync(o => o.IdentityUserId == userId);
        }
        else if (userType == "BusinessOwner")
        {
            businessOwnerProfile = await dbContext.BusinessOwners
                .FirstOrDefaultAsync(b => b.IdentityUserId == userId);
        }
    }

    private void ToggleEditMode()
    {
        statusMessage = null;
        if (!isEditMode)
        {
            if (userType == "DogOwner" && dogOwnerProfile != null)
            {
                editDogOwner = new DogOwner { FirstName = dogOwnerProfile.FirstName, LastName = dogOwnerProfile.LastName };
            }
            else if (userType == "BusinessOwner" && businessOwnerProfile != null)
            {
                editBusinessOwner = new BusinessOwner { BusinessName = businessOwnerProfile.BusinessName, ContactEmail = businessOwnerProfile.ContactEmail };
            }
            isEditMode = true;
        }
        else
        {
            isEditMode = false;
        }
    }

    private async Task HandleProfileUpdateAsync()
    {
        if (isSaving || string.IsNullOrEmpty(userId)) return;
        
        isSaving = true;
        statusMessage = null;

        try
        {
            using var scope = ServiceProvider.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<DoggoDbContext>();

            if (userType == "DogOwner" && editDogOwner != null)
            {
                var originalProfile = await dbContext.DogOwners.FirstOrDefaultAsync(o => o.IdentityUserId == userId);
                if (originalProfile != null)
                {
                    originalProfile.FirstName = editDogOwner.FirstName.Trim();
                    originalProfile.LastName = editDogOwner.LastName.Trim();
                    await dbContext.SaveChangesAsync();
                }
            }
            else if (userType == "BusinessOwner" && editBusinessOwner != null)
            {
                var originalProfile = await dbContext.BusinessOwners.FirstOrDefaultAsync(b => b.IdentityUserId == userId);
                if (originalProfile != null)
                {
                    originalProfile.BusinessName = editBusinessOwner.BusinessName.Trim();
                    originalProfile.ContactEmail = editBusinessOwner.ContactEmail.Trim();
                    await dbContext.SaveChangesAsync();
                }
            }

            var sessionState = scope.ServiceProvider.GetRequiredService<UserSessionState>();
            if (sessionState != null)
            {
                await sessionState.EnsureProfileLoadedAsync();
            }

            await LoadProfileDataAsync();
            isEditMode = false;
            statusMessage = "Success: Account profile saved cleanly.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: Operational transaction failure: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
